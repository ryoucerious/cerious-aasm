{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "electron",
    "rootDir": "electron",
    "types": ["node"]
  },
  "include": [
    "electron/**/*"
  ],
  "exclude": [
    "electron/**/*.test.ts",
    "electron/**/*.spec.ts"
  ]
}
