{
  "extends": "./tsconfig.electron.json",
  "compilerOptions": {
    // Tests run under Jest on Node 20, which compiles them as ES2022 (tsconfig.json). The app
    // itself stays checked at ES2020 by tsconfig.electron.json.
    "target": "ES2022",
    "rootDir": ".",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron"
  ]
}